datasource db {
  provider  = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  bio           String?
  city          String?
  country       String?
  phone         String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  accounts      Account[]
  sessions      Session[]
  trips         Trip[]
  notes         TripNote[]
  checklists    PackingChecklist[]
  reviews       CommunityPost[]
}

model Trip {
  id          String   @id @default(cuid())
  name        String
  description String?
  coverImage  String?
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("DRAFT")
  isPublic    Boolean   @default(false)
  budget      Float?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stops       TripStop[]
  expenses    Expense[]
  notes       TripNote[]
  checklist   PackingChecklist[]
  posts       CommunityPost[]
}

model TripStop {
  id         String   @id @default(cuid())
  tripId     String
  cityName   String
  country    String?
  latitude   Float?
  longitude  Float?
  startDate  DateTime?
  endDate    DateTime?
  order      Int
  budget     Float?
  notes      String?
  
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities StopActivity[]
  expenses   Expense[]
}

model Activity {
  id          String  @id @default(cuid())
  name        String
  description String?
  category    String
  city        String
  country     String?
  avgCost     Float?
  duration    Int?
  imageUrl    String?
  rating      Float   @default(0)
  
  stopActivities StopActivity[]
}

model StopActivity {
  id         String   @id @default(cuid())
  stopId     String
  activityId String
  date       DateTime?
  cost       Float?
  notes      String?
  done       Boolean  @default(false)
  
  stop       TripStop @relation(fields: [stopId], references: [id], onDelete: Cascade)
  activity   Activity @relation(fields: [activityId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  tripId      String
  stopId      String?  
  category    String
  description String
  amount      Float
  currency    String   @default("USD")
  date        DateTime
  receipt     String?
  
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stop        TripStop? @relation(fields: [stopId], references: [id], onDelete: SetNull)
}

model PackingChecklist {
  id       String         @id @default(cuid())
  tripId   String
  userId   String
  items    PackingItem[]
  
  trip     Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id])
}

model PackingItem {
  id          String          @id @default(cuid())
  checklistId String
  name        String
  category    String
  isPacked    Boolean         @default(false)
  
  checklist   PackingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
}

model TripNote {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  title     String
  content   String
  stopId    String?
  day       Int?
  createdAt DateTime @default(now())
  
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model CommunityPost {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  content   String
  rating    Float?
  images    String[]
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  
  trip      Trip     @relation(fields: [tripId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
